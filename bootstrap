#!/usr/bin/env bash
set -euo pipefail

# orglens bootstrap — set a machine up for orglens and its decks.
#
# Usage:
#   ./bootstrap                              # editable install, plus this repo's skills
#   ./bootstrap --pinned                     # non-editable, for a clean machine
#   ./bootstrap --extras ~/code/orglens-extras   # include a private deck repo
#   ./bootstrap --no-skills                  # install the tool, route no skills
#   ./bootstrap --dry-run                    # print the commands, run nothing
#   ./bootstrap --uninstall                  # remove the tool and its skills, keep data
#   ./bootstrap --uninstall --yes            # ...without the confirmation prompt
#
# Assumes Python 3.11+. Idempotent: re-running it is how you pick up an edit.
#
# What it deliberately does NOT do:
#
#   Route skills itself. `npx skills add` owns the path table, because a wrong
#   skills path fails silently — files present that never load. This script
#   calls it once per repo and gets out of the way.
#
#   Install scad. scad ships its own `install.sh`, and the dependency runs one
#   way: orglens consumes scad, never the reverse. If scad is missing this says
#   so and carries on.
#
#   Distribute config templates. An earlier version of this file promised to
#   symlink `configs/*` into `~/.scad`, `~/.config/orglens` and `~/.claude`.
#   Those directories only ever held a `.gitkeep`.
#
# A repo without a `pyproject.toml` is a deck repo: its skills are routed and
# nothing is pip-installed. That is how `orglens-extras` works today, and it
# keeps working unchanged the day it grows a package.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"
SHARE_DIR="${SHARE_DIR:-$HOME/.local/share}"
EDITABLE=true
SKIP_SKILLS=false
DRY_RUN=false
UNINSTALL=false
ASSUME_YES=false
EXTRAS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --pinned)     EDITABLE=false; shift ;;
        --no-skills)  SKIP_SKILLS=true; shift ;;
        --dry-run)    DRY_RUN=true; shift ;;
        --uninstall)  UNINSTALL=true; shift ;;
        --yes|-y)     ASSUME_YES=true; shift ;;
        --extras)     EXTRAS="${2:-}"; [ -n "$EXTRAS" ] || { echo "--extras needs a path" >&2; exit 1; }; shift 2 ;;
        -h|--help)    sed -n '3,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            echo "unknown argument: $1" >&2; exit 1 ;;
    esac
done

run() {
    if [ "$DRY_RUN" = true ]; then printf '  would run: %s\n' "$*"; else "$@"; fi
}

install_package() {
    # A tool repo gets its own venv, matching how scad installs itself, so the
    # two never share a dependency resolution.
    local repo="$1" name="$2" venv="$SHARE_DIR/$2/venv"
    if [ ! -f "$repo/pyproject.toml" ]; then
        echo "  $name: no pyproject.toml — deck repo, nothing to install"
        return
    fi
    echo "  $name: installing into $venv$([ "$EDITABLE" = true ] && echo ' (editable)')"
    [ -d "$venv" ] || run python3 -m venv "$venv"
    if [ "$EDITABLE" = true ]; then
        run "$venv/bin/pip" install -q -e "$repo"
    else
        run "$venv/bin/pip" install -q "$repo"
    fi
    run mkdir -p "$LOCAL_BIN"
    local entry
    for entry in "$venv"/bin/"$name"; do
        [ -e "$entry" ] || continue
        run ln -sfn "$entry" "$LOCAL_BIN/$name"
        echo "  $name: linked $LOCAL_BIN/$name"
    done
}

route_skills() {
    local repo="$1" name="$2"
    if [ "$SKIP_SKILLS" = true ]; then return; fi
    if ! find "$repo" -name SKILL.md -not -path '*/.git/*' -print -quit | grep -q .; then
        echo "  $name: no SKILL.md anywhere — nothing to route"
        return
    fi
    echo "  $name: routing skills"
    if [ "$DRY_RUN" = true ]; then
        printf '  would run: (cd %s && npx skills add . -g -a "*" -y --full-depth)\n' "$repo"
    else
        ( cd "$repo" && npx skills add . -g -a '*' -y --full-depth )
    fi
}

# ── uninstall ──────────────────────────────────────────────────────────────
#
# `~/.agents/skills` is shared: skills from several repos, and ones installed
# by hand, live side by side. `skills ls -g` reports where each one is
# *installed*, never which repo put it there — so there is no provenance to
# match on and this falls back to matching by name. That is why it shows the
# list and asks first: a name collision would otherwise remove someone else's
# skill silently.
#
# It never touches `~/.orglens` or `~/.config/orglens`. The event log there is
# the one thing in this system that cannot be recomputed — an attribution
# exists because a person said so, not because the filesystem could answer —
# so removing it is a deliberate act, not a flag on an installer.

skill_names_in() {
    find "$1" -name SKILL.md -not -path '*/.git/*' -exec dirname {} \; 2>/dev/null \
        | while read -r d; do basename "$d"; done | sort -u
}

plan_uninstall() {
    # Prints the plan for one repo; sets PLAN_SKILLS for the caller.
    local repo="$1" name="$2" venv="$SHARE_DIR/$2/venv"
    local installed found=()
    installed="$(cd "$HOME" && npx --yes skills ls -g 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
        | awk '/^[a-zA-Z]/ {print $1}')"
    while read -r sk; do
        [ -n "$sk" ] || continue
        printf '%s\n' "$installed" | grep -qx "$sk" && found+=("$sk")
    done <<< "$(skill_names_in "$repo")"

    echo "$name ($repo)"
    if [ "$SKIP_SKILLS" = false ] && [ ${#found[@]} -gt 0 ]; then
        echo "  skills (matched by name): ${found[*]}"
    else
        echo "  skills: none matched"
    fi
    [ -L "$LOCAL_BIN/$name" ] && echo "  unlink:  $LOCAL_BIN/$name"
    [ -d "$venv" ]            && echo "  remove:  $venv"
    PLAN_SKILLS="${found[*]:-}"
    return 0
}

do_uninstall() {
    local repo="$1" name="$2" skills="$3" venv="$SHARE_DIR/$2/venv"
    if [ "$SKIP_SKILLS" = false ] && [ -n "$skills" ]; then
        # shellcheck disable=SC2086
        run npx --yes skills remove $skills -g
    fi
    [ -L "$LOCAL_BIN/$name" ] && run rm -f "$LOCAL_BIN/$name"
    [ -d "$venv" ] && run rm -rf "$venv"
    return 0
}

if [ "$UNINSTALL" = true ]; then
    echo "orglens bootstrap — uninstall"
    echo
    plan_uninstall "$HERE" orglens;            ORGLENS_SKILLS="$PLAN_SKILLS"
    EXTRAS_SKILLS=""
    if [ -n "$EXTRAS" ] && [ -d "$EXTRAS" ]; then
        echo
        plan_uninstall "$EXTRAS" "$(basename "$EXTRAS")"; EXTRAS_SKILLS="$PLAN_SKILLS"
    fi
    echo
    echo "kept, and not this script's to delete:"
    echo "  ~/.orglens/events/      attributions — cannot be recomputed"
    echo "  ~/.config/orglens/      your config"
    echo

    # One prompt for the whole operation. An uninstall that half-runs without
    # asking is worse than one that refuses.
    if [ "$DRY_RUN" = false ] && [ "$ASSUME_YES" = false ]; then
        if [ ! -t 0 ]; then
            echo "refusing: not a terminal. Re-run with --yes if you meant it." >&2
            exit 1
        fi
        read -r -p "proceed? [y/N] " ans
        case "$ans" in [yY]*) ;; *) echo "nothing done."; exit 0 ;; esac
    fi

    do_uninstall "$HERE" orglens "$ORGLENS_SKILLS"
    [ -n "$EXTRAS" ] && [ -d "$EXTRAS" ] && do_uninstall "$EXTRAS" "$(basename "$EXTRAS")" "$EXTRAS_SKILLS"
    echo "done."
    exit 0
fi

echo "orglens bootstrap"
echo

echo "orglens ($HERE)"
install_package "$HERE" orglens
route_skills "$HERE" orglens

if [ -n "$EXTRAS" ]; then
    echo
    if [ -d "$EXTRAS" ]; then
        name="$(basename "$EXTRAS")"
        echo "$name ($EXTRAS)"
        install_package "$EXTRAS" "$name"
        route_skills "$EXTRAS" "$name"
    else
        echo "extras: $EXTRAS does not exist — skipped" >&2
    fi
fi

echo
if command -v scad >/dev/null 2>&1; then
    echo "scad: present ($(command -v scad))"
else
    echo "scad: not installed. orglens works without it; \`orglens start\` and"
    echo "      \`orglens config\` need it. Install it from its own repo:"
    echo "      https://github.com/saptaxis/scoped-agent-dispatch"
fi

echo
echo "done. \`orglens where\` will tell you which roots it can see."
