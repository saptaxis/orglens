#!/usr/bin/env bash
# orgdeck bootstrap — install everything on a new macOS/Linux machine.
#
# STUB. Not implemented yet. Intended behavior:
#   1. Ensure the public tools are installed (pip: scad, orglens) — pinned for a
#      clean machine, or editable (`pip install -e`) when co-developing locally.
#   2. Symlink each deck's cards to harness locations:
#        decks/*/skills/*      -> ~/.claude/skills/        (and ~/.pi/agent/... later)
#        decks/*/agents/*      -> ~/.claude/agents/
#        configs/scad/*        -> ~/.scad/templates/
#        configs/orglens/*     -> ~/.config/orglens/
#        configs/claude/*      -> ~/.claude/
#   3. Be idempotent and re-runnable.
#
# Decision pending: hand-rolled (this script + GNU stow) vs. chezmoi
# (`chezmoi init --apply <repo>`, cross-platform templating + run_once_ installs).
# See traitful-docs .../traitful-workflow-ecosystem/overview.md § Packaging.

set -euo pipefail
echo "orgdeck bootstrap: not implemented yet — see comments in this file."
exit 1
